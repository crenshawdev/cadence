{
  "invocation": "uat-record-refused",
  "operation": "uat record",
  "bundle": "slice",
  "script": "cadence-core/bin/planning.mjs",
  "argv": [
    "uat",
    "record",
    "--phase",
    "1",
    "--item",
    "999",
    "--result",
    "pass",
    "--dir",
    "<FIXTURE>/.planning"
  ],
  "stdin": null,
  "env": {
    "PATH": "<FIXTURE>/.golden-env/bin",
    "HOME": "<FIXTURE>/.golden-env/user-home",
    "TZ": "UTC",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "CADENCE_GLOBAL_CONFIG": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_MANAGED_SETTINGS": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_USER_SETTINGS": "<FIXTURE>/.golden-env/empty.json"
  },
  "node": "26",
  "exit": 1,
  "stdout": {
    "ok": false,
    "reason": "unknown-item",
    "detail": "no item 999 in UAT.md",
    "hint": "re-run with a number that appears in this phase's UAT.md; if the item you meant was never added, `uat refresh --phase <N>` appends it first"
  },
  "stderr": "",
  "files": {},
  "deleted": []
}
