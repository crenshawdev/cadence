{
  "invocation": "review-provider-consult-no-openai-key",
  "operation": "review-provider consult",
  "bundle": "config",
  "script": "cadence-core/bin/review-provider.mjs",
  "argv": [
    "consult",
    "--provider",
    "openai",
    "--model",
    "golden-model"
  ],
  "stdin": "{\"situation\":\"A bounded offline probe.\"}",
  "env": {
    "PATH": "<FIXTURE>/.golden-env/bin",
    "HOME": "<FIXTURE>/.golden-env/user-home",
    "TZ": "UTC",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "CADENCE_GLOBAL_CONFIG": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_MANAGED_SETTINGS": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_USER_SETTINGS": "<FIXTURE>/.golden-env/empty.json"
  },
  "node": "26",
  "exit": 1,
  "stdout": {
    "ok": false,
    "reason": "no-key",
    "detail": "set env $OPENAI_API_KEY or <FIXTURE>/.golden-env/user-home/.config/cadence/providers.env",
    "hint": "write the key into that env file as NAME=value, or export it in this shell, then re-run - the key is never read from a repo config"
