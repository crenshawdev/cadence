{
  "invocation": "uat-refresh-refused",
  "operation": "uat refresh",
  "bundle": "planning-inputs",
  "script": "cadence-core/bin/planning.mjs",
  "argv": [
    "uat",
    "refresh",
    "--phase",
    "1",
    "--dir",
    "<FIXTURE>/.planning"
  ],
  "stdin": "{}",
  "env": {
    "PATH": "<FIXTURE>/.golden-env/bin",
    "HOME": "<FIXTURE>/.golden-env/user-home",
    "TZ": "UTC",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "CADENCE_GLOBAL_CONFIG": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_MANAGED_SETTINGS": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_USER_SETTINGS": "<FIXTURE>/.golden-env/empty.json"
  },
  "node": "26",
  "exit": 1,
  "stdout": {
    "ok": false,
    "reason": "bad-payload",
    "detail": "expected a JSON array of {name, expected}",
    "hint": "send an ARRAY, and give every element both a `name` and an `expected` - fix the step that composed the payload and send it again"
  },
  "stderr": "",
  "files": {},
  "deleted": []
}
