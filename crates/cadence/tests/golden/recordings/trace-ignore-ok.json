{
  "invocation": "trace-ignore-ok",
  "operation": "trace ignore",
  "bundle": "slice",
  "script": "cadence-core/bin/planning.mjs",
  "argv": [
    "trace",
    "ignore",
    "--root",
    "<FIXTURE>",
    "--dir",
    "<FIXTURE>/.planning"
  ],
  "stdin": null,
  "env": {
    "PATH": "<FIXTURE>/.golden-env/bin",
    "HOME": "<FIXTURE>/.golden-env/user-home",
    "TZ": "UTC",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "CADENCE_GLOBAL_CONFIG": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_MANAGED_SETTINGS": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_USER_SETTINGS": "<FIXTURE>/.golden-env/empty.json"
  },
  "node": "26",
  "exit": 0,
  "stdout": {
    "ok": true,
    "root": "<FIXTURE>",
    "file": "<FIXTURE>/.gitignore",
    "line": ".planning/trace.jsonl",
    "rotated_line": ".planning/trace.1.jsonl",
    "reads_lines": [
      ".planning/reads.jsonl",
      ".planning/reads.1.jsonl",
      ".planning/reads.1.jsonl.claim",
      ".planning/reads.1.jsonl.claim.*",
      ".planning/reads.jsonl.rotate.*",
      ".planning/reads.1.jsonl.evict.*"
    ],
    "ignored": false,
    "tracked": false,
    "method": "file",
    "written": true
  },
  "stderr": "",
  "files": {
    ".gitignore": "# Cadence's joined run record - local diagnostics only, one machine's routing/provider/worker events\n.planning/trace.jsonl\n.planning/trace.1.jsonl\n\n# ...and Cadence's per-tool-call read record, the generation ITS rotation leaves behind, and that rotation's claim files and killed-mid-rotation temps\n.planning/reads.jsonl\n.planning/reads.1.jsonl\n.planning/reads.1.jsonl.claim\n.planning/reads.1.jsonl.claim.*\n.planning/reads.jsonl.rotate.*\n.planning/reads.1.jsonl.evict.*\n"
  },
  "deleted": []
}
