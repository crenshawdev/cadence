{
  "invocation": "uat-merge-refused",
  "operation": "uat merge",
  "bundle": "planning-inputs",
  "script": "cadence-core/bin/planning.mjs",
  "argv": [
    "uat",
    "merge",
    "--phase",
    "1",
    "--payload",
    "<FIXTURE>/invalid.json",
    "--dir",
    "<FIXTURE>/.planning"
  ],
  "stdin": null,
  "env": {
    "PATH": "<FIXTURE>/.golden-env/bin",
    "HOME": "<FIXTURE>/.golden-env/user-home",
    "TZ": "UTC",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "CADENCE_GLOBAL_CONFIG": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_MANAGED_SETTINGS": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_USER_SETTINGS": "<FIXTURE>/.golden-env/empty.json"
  },
  "node": "26",
  "exit": 1,
  "stdout": {
    "ok": false,
    "reason": "bad-payload",
    "detail": "payload carries none of passes, gaps, human_checks as an array",
    "hint": "add at least one of those three to the findings payload as an array - an object with none of them would merge nothing while reporting a clean deep pass"
  },
  "stderr": "",
  "files": {},
  "deleted": []
}
