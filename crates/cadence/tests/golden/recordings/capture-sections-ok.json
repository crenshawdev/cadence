{
  "invocation": "capture-sections-ok",
  "operation": "capture-sections",
  "bundle": "slice",
  "script": "cadence-core/bin/planning.mjs",
  "argv": [
    "capture-sections",
    "--dir",
    "<FIXTURE>/.planning"
  ],
  "stdin": null,
  "env": {
    "PATH": "<FIXTURE>/.golden-env/bin",
    "HOME": "<FIXTURE>/.golden-env/user-home",
    "TZ": "UTC",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "CADENCE_GLOBAL_CONFIG": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_MANAGED_SETTINGS": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_USER_SETTINGS": "<FIXTURE>/.golden-env/empty.json"
  },
  "node": "26",
  "exit": 0,
  "stdout": {
    "ok": true,
    "file": "<FIXTURE>/.planning/CAPTURE.md",
    "exists": true,
    "walk": [
      "Todos",
      "Seeds",
      "Notes"
    ],
    "sections": [
      {
        "heading": "Todos",
        "bullets": 0,
        "in_walk": true
      },
      {
        "heading": "Seeds",
        "bullets": 0,
        "in_walk": true
      },
      {
        "heading": "Notes",
        "bullets": 0,
        "in_walk": true
      }
    ]
  },
  "stderr": "",
  "files": {},
  "deleted": []
}
