{
  "invocation": "capture-ok",
  "operation": "capture",
  "bundle": "slice",
  "script": "cadence-core/bin/planning.mjs",
  "argv": [
    "capture",
    "--kind",
    "todo",
    "--text",
    "Exercise the capture queue.",
    "--phase",
    "1",
    "--dir",
    "<FIXTURE>/.planning"
  ],
  "stdin": null,
  "env": {
    "PATH": "<FIXTURE>/.golden-env/bin",
    "HOME": "<FIXTURE>/.golden-env/user-home",
    "TZ": "UTC",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "CADENCE_GLOBAL_CONFIG": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_MANAGED_SETTINGS": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_USER_SETTINGS": "<FIXTURE>/.golden-env/empty.json"
  },
  "node": "26",
  "exit": 0,
  "stdout": {
    "ok": true,
    "file": "<FIXTURE>/.planning/CAPTURE.md",
    "kind": "todo",
    "bullet": "- [ ] (phase 1) Exercise the capture queue.",
    "heading": "## Todos",
    "created": false
  },
  "stderr": "",
  "files": {
    ".planning/CAPTURE.md": "# Capture\n\n## Todos\n\n- [ ] (phase 1) Exercise the capture queue.\n\n## Seeds\n\n## Notes\n"
  },
  "deleted": []
}
