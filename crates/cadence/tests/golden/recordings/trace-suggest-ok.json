{
  "invocation": "trace-suggest-ok",
  "operation": "trace suggest",
  "bundle": "slice",
  "script": "cadence-core/bin/planning.mjs",
  "argv": [
    "trace",
    "suggest",
    "--phase",
    "1",
    "--dir",
    "<FIXTURE>/.planning"
  ],
  "stdin": null,
  "env": {
    "PATH": "<FIXTURE>/.golden-env/bin",
    "HOME": "<FIXTURE>/.golden-env/user-home",
    "TZ": "UTC",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "CADENCE_GLOBAL_CONFIG": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_MANAGED_SETTINGS": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_USER_SETTINGS": "<FIXTURE>/.golden-env/empty.json"
  },
  "node": "26",
  "exit": 0,
  "stdout": {
    "ok": true,
    "file": "<FIXTURE>/.planning/trace.jsonl",
    "scope": "1",
    "events_read": 3,
    "reads": {
      "file": "<FIXTURE>/.planning/reads.jsonl"
    },
    "suggestions": []
  },
  "stderr": "",
  "files": {},
  "deleted": []
}
