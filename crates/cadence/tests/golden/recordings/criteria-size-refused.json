{
  "invocation": "criteria-size-refused",
  "operation": "criteria-size",
  "bundle": "slice",
  "script": "cadence-core/bin/planning.mjs",
  "argv": [
    "criteria-size",
    "--dir",
    "<FIXTURE>/missing"
  ],
  "stdin": null,
  "env": {
    "PATH": "<FIXTURE>/.golden-env/bin",
