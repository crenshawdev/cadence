{
  "invocation": "trace-render-ok",
  "operation": "trace render",
  "bundle": "slice",
  "script": "cadence-core/bin/planning.mjs",
  "argv": [
    "trace",
    "render",
    "--phase",
    "1",
    "--dir",
    "<FIXTURE>/.planning"
  ],
  "stdin": null,
  "env": {
    "PATH": "<FIXTURE>/.golden-env/bin",
    "HOME": "<FIXTURE>/.golden-env/user-home",
    "TZ": "UTC",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
