{
  "invocation": "trace-ignore-refused",
  "operation": "trace ignore",
  "bundle": "slice",
  "script": "cadence-core/bin/planning.mjs",
  "argv": [
    "trace",
    "ignore",
    "--root",
    "<FIXTURE>/missing",
    "--dir",
    "<FIXTURE>/.planning"
  ],
  "stdin": null,
  "env": {
    "PATH": "<FIXTURE>/.golden-env/bin",
    "HOME": "<FIXTURE>/.golden-env/user-home",
    "TZ": "UTC",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "CADENCE_GLOBAL_CONFIG": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_MANAGED_SETTINGS": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_USER_SETTINGS": "<FIXTURE>/.golden-env/empty.json"
  },
  "node": "26",
  "exit": 1,
  "stdout": {
    "ok": false,
    "reason": "no-root",
    "detail": "<FIXTURE>/missing not found",
    "hint": "point --root at the PROJECT root, the directory holding .gitignore - it is deliberately not --dir, which names .planning/"
  },
  "stderr": "",
  "files": {},
  "deleted": []
}
