        "complete": true
      }
    ],
    "replay": true,
    "dispatch_set": [],
    "reports_read": [
      "phases/1/reports/plan-1.md",
      "phases/1/reports/plan-2.md"
    ]
  },
  "stderr": "",
  "files": {},
  "deleted": []
