{
  "invocation": "cursor-set-ok",
  "operation": "cursor set",
  "bundle": "slice",
  "script": "cadence-core/bin/planning.mjs",
  "argv": [
    "cursor",
    "set",
    "--phase",
    "1",
    "--status",
    "planned",
    "--next",
    "/cad-execute 1",
    "--dir",
    "<FIXTURE>/.planning"
  ],
  "stdin": null,
  "env": {
    "PATH": "<FIXTURE>/.golden-env/bin",
    "HOME": "<FIXTURE>/.golden-env/home",
    "TZ": "UTC",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "CADENCE_GLOBAL_CONFIG": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_MANAGED_SETTINGS": "<FIXTURE>/.golden-env/empty.json",
    "CADENCE_USER_SETTINGS": "<FIXTURE>/.golden-env/empty.json"
  },
  "node": "26",
  "exit": 0,
  "stdout": {
    "ok": true,
    "cursor": {
      "phase": 1,
      "total": 2,
      "name": "Archived phase",
      "status": "planned",
      "next": "/cad-execute 1",
      "updated": "<TODAY>"
    }
  },
  "stderr": "",
  "files": {
    ".planning/STATE.md": "# State\n\nPhase: 1 of 2 (Archived phase)\nStatus: planned\nNext: /cad-execute 1\nUpdated: <TODAY>\n"
  },
  "deleted": []
}
