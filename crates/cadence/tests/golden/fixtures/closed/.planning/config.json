      "model": "opus",
      "effort": "high"
    },
    "cad-verifier": {
      "model": "opus",
      "effort": "high"
    },
    "cad-reviewer": {
      "model": "opus",
      "effort": "high"
    },
    "cad-executor": {
      "model": "opus",
      "effort": "high"
    },
    "cad-plan-checker": {
      "model": "opus",
      "effort": "high"
    }
  }
