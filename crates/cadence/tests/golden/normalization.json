{
  "mechanism": "named-fields",
  "rules": [
    {
      "id": "trace-ts",
      "target": "file",
      "path_suffix": ".planning/trace.jsonl",
      "pattern": "\"ts\":\"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z\"",
      "replace": "\"ts\":\"<NOW>\"",
      "site": "cadence-core/bin/lib/trace.mjs:415"
    },
    {
      "id": "reads-ts",
      "target": "file",
      "path_suffix": ".planning/reads.jsonl",
      "pattern": "\"ts\":\"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z\"",
      "replace": "\"ts\":\"<NOW>\"",
      "site": "cadence-core/bin/lib/read-trace.mjs:392"
    },
    {
      "id": "cursor-updated",
      "target": "stdout",
      "key": "cursor.updated",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "replace": "<TODAY>",
      "site": "cadence-core/bin/planning/cursor-set.mjs:147"
    },
    {
      "id": "state-updated",
      "target": "file",
      "path_suffix": ".planning/STATE.md",
      "pattern": "^Updated: [0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "replace": "Updated: <TODAY>",
      "site": "cadence-core/bin/planning/cursor-set.mjs:147"
    },
    {
      "id": "uat-started",
      "target": "file",
      "path_suffix": "UAT.md",
      "pattern": "^started: [0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "replace": "started: <TODAY>",
      "site": "cadence-core/bin/planning/uat.mjs:121"
    },
    {
      "id": "uat-updated",
      "target": "file",
      "path_suffix": "UAT.md",
      "pattern": "^updated: [0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "replace": "updated: <TODAY>",
      "site": "cadence-core/bin/planning/uat.mjs:40"
    }
  ]
}
