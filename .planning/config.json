{
  "review": {
    "triggers": {
      "risk_surface": {
        "surfaces": [
          "secrets",
          "destructive",
          "untrusted_input"
        ],
        "tier": "flagship",
        "effort": "high"
      },
      "diff": {
        "tier": "flagship"
      },
      "plan": {
        "tier": "flagship",
        "effort": "high"
      }
    },
    "request_timeout_ms": 600000
  },
  "model": {
    "escalate_on_failure": false
  },
  "git": {
    "auto_close": true,
    "forge_provider": "github",
    "forge_repo": "crenshawdev/cadence",
    "forge_host": null
  },
  "roles": {
    "cad-planner": {
      "model": "fable",
      "effort": "xhigh"
    },
    "cad-assumptions-analyzer": {
      "model": "opus",
      "effort": "high"
    },
    "cad-verifier": {
      "model": "opus",
      "effort": "high"
    },
    "cad-reviewer": {
      "model": "opus",
      "effort": "high"
    },
    "cad-executor": {
      "model": "opus",
      "effort": "xhigh"
    },
    "cad-plan-checker": {
      "model": "opus",
      "effort": "high"
    }
  },
  "workflow": {
    "plan_check": true
  },
  "parallelization": {
    "enabled": false,
    "use_worktrees": false
  },
  "planning": {
    "max_capture_bullets": 25
  },
  "memory": {
    "backend": "none"
  }
}
