{
  "stakes": "shipped",
  "git": {
    "auto_branch": "auto",
    "base_branch": "main",
    "create_tag": true
  },
  "review": {
    "request_timeout_ms": 600000,
    "consult": {
      "enabled": true
    },
    "triggers": {
      "risk_surface": {
        "surfaces": [
          "auth",
          "migrations",
          "billing",
          "concurrency",
          "destructive",
          "secrets",
          "api_contract",
          "untrusted_input"
        ]
      },
      "diff": {
        "gate": "blocking"
      },
      "phase_diff": {
        "gate": "adjudicated"
      }
    }
  },
  "model": {
    "effort": {
      "cad-verifier": null,
      "cad-plan-checker": null
    },
    "escalate_on_failure": true
  }
}
