{
  "model": {
    "escalate_on_failure": false
  },
  "workflow": {
    "research": true,
    "inline_plan_threshold": 2,
    "test_command": "node --test cadence-core/bin/*.test.mjs",
    "plan_check": false
  },
  "parallelization": {
    "max_concurrent_agents": 6
  },
  "git": {
    "auto_branch": "auto",
    "base_branch": "main",
    "create_tag": false
  },
  "review": {
    "request_timeout_ms": 600000,
    "consult": {
      "enabled": true
    },
    "triggers": {
      "plan": {
        "gate": "advisory",
        "tier": "cheap"
      },
      "pre_ship": {
        "gate": "off"
      }
    }
  }
}
