{
  "granularity": "standard",
  "stakes": "shipped",
  "model": { "escalate_on_failure": true },
  "workflow": {
    "research": false, "plan_check": true, "verifier": true, "skip_discuss": false,
    "subagent_timeout": 300000, "inline_plan_threshold": 3,
    "test_command": null, "lint_command": null
  },
  "parallelization": {
    "enabled": true, "max_concurrent_agents": 3, "min_plans_for_parallel": 2,
    "use_worktrees": true
  },
  "git": {
    "protected_branches": ["main", "master"],
    "on_protected": "ask",
    "integration_branch": "milestone",
    "auto_branch": "ask",
    "base_branch": null,
    "create_tag": true,
    "on_land_cleanup": true,
    "auto_close": false
  },
  "planning": { "commit_docs": true },
  "memory": { "backend": "builtin" },
  "review": {
    "mode": "adjudicated",
    "reviewers": ["claude-subagent"],
    "key_file": null,
    "providers": {
      "openai": { "tiers": { "flagship": null, "balanced": null, "cheap": null } },
      "gemini": { "tiers": { "flagship": null, "balanced": null, "cheap": null } },
      "deepseek": { "tiers": { "flagship": null, "balanced": null, "cheap": null } }
    },
    "consult": { "enabled": false, "tier": "flagship", "effort": "high", "attempt_threshold": 3 },
    "decision_review": { "tier": "flagship", "effort": "high" }
  }
}
